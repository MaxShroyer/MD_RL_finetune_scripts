{
  "env_file": ".env.staging",
  "api_key_env_var": "CICID_GPUB_MOONDREAM_API_KEY_1",
  "base_url": "https://api-staging.moondream.ai/v1",
  "dataset_source": "hf_hub",
  "hf_dataset_repo_id": "maxs-m87/neon_tree_detect_v1",
  "hf_dataset_revision": "main",
  "source_split": "train",
  "window_width": 400,
  "window_height": 400,
  "step_x": 200,
  "step_y": 200,
  "fps": 12,
  "path_style": "serpentine",
  "max_source_rasters": 1,
  "source_selection": "most_boxes",
  "output_root": "neon_tree/outputs/flyovers",
  "base_model": "moondream3-preview",
  "prompt": "tree",
  "temperature": 0.0,
  "top_p": 1.0,
  "max_tokens": 256,
  "max_objects": 256,
  "timeout": 300.0,
  "request_retries": 3,
  "request_retry_backoff_s": 8.0,
  "tiling_enabled": true,
  "tile_width": 1024,
  "tile_height": 1024,
  "tile_overlap_x": 128,
  "tile_overlap_y": 128,
  "merge_iou_threshold": 0.5,
  "benchmark_max_samples": 256,
  "tracking_max_frames": 256,
  "track_activation_threshold": 0.25,
  "lost_track_buffer": 30,
  "minimum_matching_threshold": 0.8,
  "minimum_consecutive_frames": 1,
  "track_frame_rate": 12
}
