{
  "env_file": "pokemon_cards/.env.staging",
  "api_key_env_var": "CICID_GPUB_MOONDREAM_API_KEY_2",
  "base_url": "https://api-staging.moondream.ai/v1",
  "dataset_source": "local_jsonl",
  "dataset_dir": "pokemon_cards/outputs/thefusion21_pokemoncards_v1_teacher",
  "train_split": "train",
  "val_split": "val",
  "final_eval_splits": [
    "val",
    "test"
  ],
  "finetune_id": "",
  "finetune_name": "",
  "rank": 32,
  "num_steps": 600,
  "resume_step": 0,
  "batch_size": 4,
  "group_size": 2,
  "lr": 0.000005,
  "temperature": 1.0,
  "top_p": 0.9,
  "eval_temperature": 0.0,
  "eval_top_p": 1.0,
  "max_tokens": 256,
  "max_tokens_by_task": {
    "card_identity": 96,
    "card_core": 192,
    "attack_overview": 160,
    "card_summary": 96
  },
  "reasoning": true,
  "eval_reasoning": true,
  "off_policy": false,
  "off_policy_mix_ratio": 0.0,
  "off_policy_buffer_size": 4096,
  "off_policy_warmup_steps": 30,
  "off_policy_min_buffer_groups": 128,
  "task_sampling_weights": {
    "card_identity": 0.4,
    "card_core": 0.3,
    "attack_overview": 0.2,
    "card_summary": 0.1
  },
  "max_workers": 1,
  "eval_every": 10,
  "save_every": 10,
  "save_on_eval": true,
  "save_eval_predictions": true,
  "eval_predictions_output_dir": "pokemon_cards/outputs/eval_predictions/stage2_reasoning_distill",
  "eval_batch_size": 8,
  "eval_max_samples": 1000,
  "checkpoint_avg_splits": [
    "val",
    "test"
  ],
  "checkpoint_avg_metric": "eval_combined_reward_mean",
  "checkpoint_ranking_output": "pokemon_cards/outputs/checkpoint_ranking_stage2_reasoning_distill.json",
  "seed": 42,
  "best_metric": "eval_combined_reward_mean",
  "no_progress": false,
  "wandb_project": "moondream-pokemon-cards-query-rl",
  "wandb_run_name": "pokemon-cards-stage2-reasoning-distill"
}
