        "CICID_GPUB_MOONDREAM_API_KEY_1",
        "CICID_GPUB_MOONDREAM_API_KEY_2",
        "CICID_GPUB_MOONDREAM_API_KEY_3",
        "CICID_GPUB_MOONDREAM_API_KEY_4"
      ],
      "base_url": "https://api-staging.moondream.ai/v1",
