{
  "env_file": ".env.staging",
  "api_key": "",
  "api_key_env_var": "CICID_GPUB_MOONDREAM_API_KEY_4",
  "base_url": "https://api-staging.moondream.ai/v1",
  "dataset_source": "local_jsonl",
  "dataset_dir": "vqa_rad/outputs/vqa_rad_query_v1",
  "train_split": "train",
  "val_split": "validation",
  "final_eval_splits": [
    "validation",
    "test"
  ],
  "finetune_id": "",
  "finetune_name": "",
  "rank": 32,
  "seed": 42,
  "num_steps": 500,
  "resume_step": 0,
  "batch_size": 32,
  "group_size": 8 ,
  "lr": 0.00001,
  "max_workers": 4,
  "rollout_retries": 2,
  "rollout_retry_backoff_s": 1.0,
  "temperature": 1.0,
  "top_p": 0.9,
  "eval_temperature": 0.0,
  "eval_top_p": 1.0,
  "max_tokens": 64,
  "reasoning": false,
  "answer_type_sampling_weights": {
    "close_ended": 1.0,
    "open_ended": 1.0
  },
  "off_policy": true,
  "off_policy_mix_ratio": 0.25,
  "off_policy_buffer_size": 1024,
  "off_policy_warmup_steps": 10,
  "off_policy_min_buffer_groups": 64,
  "open_exact_weight": 0.55,
  "open_token_f1_weight": 0.25,
  "open_numeric_weight": 0.1,
  "open_brevity_weight": 0.05,
  "eval_every": 10,
  "save_every": 10,
  "save_on_eval": true,
  "eval_batch_size": 16,
  "eval_max_samples": 256,
  "save_eval_predictions": true,
  "eval_predictions_output_dir": "vqa_rad/outputs/eval_predictions/vqa_rad_query_ballanced_lr_low",
  "best_metric": "eval_balanced_accuracy",
  "skip_final_eval": false,
  "no_progress": false,
  "wandb_project": "moondream-vqa-rad-query-rl",
  "wandb_run_name": "vqa-rad-query-ballanced-lr-low"
}
