{
  "env_file": "disaster_m3/.env.staging",
  "base_url": "https://api-staging.moondream.ai/v1",
  "dataset_dir": "disaster_m3/dataset/full",
  "mode": "rl",
  "rank": 32,
  "max_workers": 4,
  "image_quality": 92,
  "detect_max_objects": 64,
  "seed": 42,
  "eval_every": 10,
  "save_every": 10,
  "eval_max_samples": 128,
  "eval_sample_count": 25,
  "timeout": 120.0,
  "rollout_retries": 2,
  "rollout_retry_backoff_s": 5.0,
  "wandb_project": "moondream-disaster-m3-mixed",
  "run_output_dir": "outputs/runs",
  "benchmark_output_dir": "outputs/benchmarks/disaster_m3",
  "off_policy": true,
  "off_policy_mix_ratio": 0.25,
  "off_policy_buffer_size": 2048,
  "off_policy_warmup_steps": 10,
  "off_policy_min_buffer_groups": 64,
  "async_checkpoint_eval": true,
  "async_checkpoint_eval_dir": "outputs/async_checkpoint_eval/disaster_m3",
  "async_checkpoint_eval_max_inflight": 1,
  "async_checkpoint_eval_drain_on_exit": true,
  "rl_steps": 300,
  "rl_batch_size": 32,
  "rl_group_size": 8,
  "rl_temperature": 0.8,
  "rl_top_p": 1.0,
  "rl_max_tokens": 384,
  "rl_lr": 5e-05,
  "rl_reasoning": false
}
