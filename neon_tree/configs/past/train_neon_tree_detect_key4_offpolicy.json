{
  "env_file": ".env.staging",
  "api_key_env_var": "CICID_GPUB_MOONDREAM_API_KEY_4",
  "base_url": "https://api-staging.moondream.ai/v1",
  "hf_dataset_repo_id": "maxs-m87/neon_tree_detect_v1",
  "hf_dataset_revision": "main",
  "train_split": "train",
  "val_split": "validation",
  "prompt": "individual trees",
  "base_model": "moondream3-preview",
  "finetune_name": "neon-tree-detect-004_tiling_prompt-v2_offpolicy",
  "rank": 16,
  "num_steps": 200,
  "batch_size": 32,
  "group_size": 16,
  "max_workers": 4,
  "lr": 0.00002,
  "selection_metric": "f1",
  "reward_metric": "f1",
  "timeout": 300.0,
  "request_retries": 3,
  "request_retry_backoff_s": 8.0,
  "eval_every": 10,
  "save_every": 10,
  "off_policy": true,
  "off_policy_mix_ratio": 0.25,
  "off_policy_buffer_size": 1024,
  "off_policy_warmup_steps": 10,
  "off_policy_min_buffer_groups": 64,
  "tiling_enabled": true,
  "tile_width": 400,
  "tile_height": 400,
  "tile_overlap_x": 200,
  "tile_overlap_y": 200,
  "merge_iou_threshold": 0.4,
  "positive_tile_probability": 0.8,
  "include_empty_tiles": true,
  "async_checkpoint_eval": true,
  "async_checkpoint_eval_dir": "neon_tree/outputs/async_checkpoint_eval/key4_prompt-v2_offpolicy",
  "async_checkpoint_eval_max_inflight": 1,
  "async_checkpoint_eval_drain_on_exit": true,
  "auto_benchmark_best_checkpoint": true,
  "auto_benchmark_output_json": "neon_tree/outputs/benchmarks/key4_prompt-v2_offpolicy_best_checkpoint_validation.json",
  "wandb_project": "moondream-neon-tree-detect",
  "wandb_run_name": "neon-tree-detect-tiling-lr-1e-4-r16_prompt-v2_offpolicy",
  "wandb_log_profile": "lean"
}
