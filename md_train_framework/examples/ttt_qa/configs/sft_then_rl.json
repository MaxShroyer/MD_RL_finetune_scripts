      "steps": 20,
      "temperature": 0.0,
      "top_p": 1.0
    },
    {
      "batch_size": 16,
      "group_size": 8,
      "lr": 0.001,
      "max_tokens": 64,
      "mode": "rl",
      "name": "rl",
      "reasoning": true,
      "steps": 100,
      "temperature": 1.0,
      "top_p": 1.0
