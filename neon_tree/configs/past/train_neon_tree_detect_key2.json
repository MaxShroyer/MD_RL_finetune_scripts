{
  "env_file": ".env.staging",
  "api_key_env_var": "CICID_GPUB_MOONDREAM_API_KEY_2",
  "base_url": "https://api-staging.moondream.ai/v1",
  "hf_dataset_repo_id": "maxs-m87/neon_tree_detect_v1",
  "hf_dataset_revision": "main",
  "train_split": "train",
  "val_split": "validation",
  "prompt": "individual trees",
  "base_model": "moondream3-preview",
  "finetune_name": "neon-tree-detect-002_tiling_prompt-v2",
  "rank": 16,
  "num_steps": 200,
  "batch_size": 16,
  "group_size": 4,
  "max_workers": 4,
  "lr": 0.0002,
  "selection_metric": "miou",
  "reward_metric": "miou",
  "timeout": 300.0,
  "request_retries": 3,
  "request_retry_backoff_s": 8.0,
  "eval_every": 10,
  "save_every": 10,
  "tiling_enabled": true,
  "tile_width": 800,
  "tile_height": 800,
  "tile_overlap_x": 128,
  "tile_overlap_y": 128,
  "merge_iou_threshold": 0.5,
  "positive_tile_probability": 0.8,
  "include_empty_tiles": true,
  "async_checkpoint_eval": true,
  "async_checkpoint_eval_dir": "neon_tree/outputs/async_checkpoint_eval/key2_prompt_v2",
  "async_checkpoint_eval_max_inflight": 1,
  "async_checkpoint_eval_drain_on_exit": true,
  "auto_benchmark_best_checkpoint": true,
  "auto_benchmark_output_json": "neon_tree/outputs/benchmarks/key2_prompt_v2_best_checkpoint_validation.json",
  "wandb_project": "moondream-neon-tree-detect",
  "wandb_run_name": "neon-tree-detect-tiling_prompt-v2",
  "wandb_log_profile": "lean"
}
