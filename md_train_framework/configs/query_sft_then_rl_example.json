{
  "backend": {
    "id": "generic_query",
    "train_overrides": {
      "api_key_env_vars": [
        "CICID_GPUB_MOONDREAM_API_KEY_1",
        "CICID_GPUB_MOONDREAM_API_KEY_2"
      ],
      "base_url": "https://api-staging.moondream.ai/v1",
      "grader_api_base": "https://openrouter.ai/api/v1",
      "grader_api_key_env_var": "OPENROUTER_API_KEY",
      "grader_model_id": "openai/gpt-4.1-mini",
      "rank": 32
    }
  },
  "dataset": {
    "path": "../../inspector_md/outputs/inspector_query_issues_v2",
    "source": "repo_dir",
    "test_split": "test",
    "train_split": "train",
    "val_split": "validation"
  },
  "eval": {
    "async_checkpoint_eval": true,
    "async_checkpoint_eval_dir": "../outputs/async_checkpoint_eval",
    "eval_every": 10,
    "final_splits": [
      "validation",
      "test"
    ],
    "max_samples": 64,
    "max_tokens": 128,
    "save_every": 10,
    "temperature": 0.0,
    "top_p": 1.0
  },
  "logging": {
    "compact_wandb": true,
    "enable_wandb": true,
    "registry_path": "../outputs/runs.db",
    "run_root": "../outputs/runs",
    "wandb_project": "moondream-md-train-framework"
  },
  "phases": [
    {
      "batch_size": 4,
      "lr": 0.0002,
      "max_tokens": 128,
      "mode": "sft",
      "name": "sft",
      "reasoning": true,
      "steps": 80,
      "temperature": 0.0,
      "top_p": 1.0
    },
    {
      "batch_size": 4,
      "lr": 5e-05,
      "max_tokens": 128,
      "mode": "rl",
      "name": "rl",
      "num_rollouts": 8,
      "reasoning": true,
      "steps": 120,
      "temperature": 0.8,
      "top_p": 1.0
    }
  ],
  "recovery": {
    "api_health_preflight": true,
    "cooldown_s": 30.0,
    "quarantine_path": "../outputs/recovery/quarantine.jsonl",
    "resume_queue_path": "../outputs/recovery/resume_queue.jsonl",
    "train_step_max_retries": 6
  },
  "reward": {
    "preset": "query_judge_hybrid"
  },
  "skill": {
    "id": "query"
  },
  "sweep": {
    "continue_top_k": 2,
    "enabled": true,
    "max_parallel": 2,
    "stage1_scale": 0.25,
    "stagger_seconds": 4.0
  },
  "task": {
    "name": "inspector_query_reasoning"
  }
}
