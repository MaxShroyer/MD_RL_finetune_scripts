{
  "env_file": ".env.staging",
  "api_key_env_var": "CICID_GPUB_MOONDREAM_API_KEY_2",
  "base_url": "https://api-staging.moondream.ai/v1",
  "hf_dataset_repo_id": "maxs-m87/neon_tree_detect_v1",
  "hf_dataset_revision": "main",
  "train_split": "train",
  "val_split": "validation",
  "prompt": "individual trees",
  "base_model": "moondream3-preview",
  "finetune_name": "neon-tree-detect-006_hybrid_recall_dense_tiles",
  "rank": 16,
  "num_steps": 300,
  "batch_size": 32,
  "group_size": 8,
  "max_workers": 4,
  "lr": 0.000075,
  "selection_metric": "f1",
  "reward_metric": "hybrid",
  "reward_fn_beta": 3.0,
  "reward_oversize_ratio_cap": 4.0,
  "reward_huge_area_cap": 0.15,
  "reward_collapse_centers_cap": 3.0,
  "timeout": 300.0,
  "request_retries": 3,
  "request_retry_backoff_s": 8.0,
  "eval_every": 10,
  "save_every": 10,
  "tiling_enabled": true,
  "tile_width": 640,
  "tile_height": 640,
  "tile_overlap_x": 320,
  "tile_overlap_y": 320,
  "merge_iou_threshold": 0.35,
  "positive_tile_probability": 1.0,
  "include_empty_tiles": true,
  "async_checkpoint_eval": true,
  "async_checkpoint_eval_dir": "neon_tree/outputs/async_checkpoint_eval/exp02_hybrid_recall_dense_tiles",
  "async_checkpoint_eval_max_inflight": 1,
  "async_checkpoint_eval_drain_on_exit": true,
  "auto_benchmark_best_checkpoint": true,
  "auto_benchmark_output_json": "neon_tree/outputs/benchmarks/exp02_hybrid_recall_dense_tiles_best_checkpoint_validation.json",
  "wandb_project": "moondream-neon-tree-detect",
  "wandb_run_name": "neon-tree-detect-006_hybrid_recall_dense_tiles",
  "wandb_log_profile": "lean"
}
