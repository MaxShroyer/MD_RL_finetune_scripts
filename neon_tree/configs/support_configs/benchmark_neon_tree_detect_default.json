{
  "env_file": ".env.staging",
  "api_key_env_var": "CICID_GPUB_MOONDREAM_API_KEY_1",
  "base_url": "https://api-staging.moondream.ai/v1",
  "dataset_source": "hf_hub",
  "hf_dataset_repo_id": "maxs-m87/neon_tree_detect_v1",
  "hf_dataset_revision": "main",
  "split": "validation",
  "base_model": "moondream3-preview",
  "prompt": "individual trees",
  "temperature": 0.0,
  "top_p": 1.0,
  "max_tokens": 256,
  "max_objects": 256,
  "timeout": 300.0,
  "request_retries": 3,
  "request_retry_backoff_s": 8.0,
  "tiling_enabled": false,
  "tile_width": 800,
  "tile_height": 800,
  "tile_overlap_x": 128,
  "tile_overlap_y": 128,
  "merge_iou_threshold": 0.5,
  "output_json": "neon_tree/outputs/benchmarks/baseline_validation.json"
}
